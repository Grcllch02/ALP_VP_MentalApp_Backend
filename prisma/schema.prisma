// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  // isinya itu mau ada kolom apa saja bisa dibuat disini

  // id itu tipe data int
  id Int @id @default(autoincrement())
  username String @db.VarChar(100)

  // data email unique artinya dia tidak boleh sama dengan yang lain atau yang sudah ada
  email String @db.VarChar(150) @unique 
  password String @db.VarChar(100)

  // untuk kasih nama tabelnya 
  @@map("users")
}

