// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User{
  // isinya itu mau ada kolom apa saja bisa dibuat disini

  // id itu tipe data int
  id Int @id @default(autoincrement())
  username String @db.VarChar(100)

  // data email unique artinya dia tidak boleh sama dengan yang lain atau yang sudah ada
  email String @db.VarChar(150) @unique 
  password String @db.VarChar(100)

  // --------- PUNYA CHELSEA ---------
  // 1 user bisa punya banyak musicFav
  musicsFav musicFav[]

  // 1 user bisa punya banyak focusTimerSession
  focusTimers focusTimerSession[]

  // 1 user bisa punya banyak gameState
  gameStates GameState[]

  // untuk kasih nama tabelnya 
  @@map("users")
}

// Fitur Chelseaa
model Music{
  id Int @id @default(autoincrement())
  title String @db.VarChar(100)
  fileUrl String @db.VarChar(100)
  duration Int @db.Integer

  // 1 music bisa punya banyak musicFav
  musicsFav musicFav[]

  // 1 music dipunyai 1 musicCategory
  musicCategory_id Int
  musicCategory musicCategory @relation(fields: [musicCategory_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  
  @@map("musics")
}

model musicFav{
  id Int @id @default(autoincrement())

  // 1 music fav dipunyai 1 user
  user_id Int
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // 1 music fav dipunyai 1 music 
  music_id Int
  music Music @relation(fields: [music_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@map("musicFavorite")
}

model musicCategory{
  id Int @id @default(autoincrement())

  name String @db.VarChar(100)

  // 1 musicCategory bisa punya banyak music
  musics Music[]

  @@map("musicCategory")
}

model focusSession{
  id Int @id @default(autoincrement())

  duration Int @db.Integer

  // 1 focusSession bisa punya banyak focusTimer
  focusTimers focusTimerSession[]

  @@map("focusSession")
}

model focusTimerSession{
  id Int @id @default(autoincrement())

  duration Int @db.Integer

  // 1 focusTimer dipunyai 1 user 
  user_id Int
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // 1 focusTimer dipunyai 1 focusSession
  focusSession_id Int
  focusSession focusSession @relation(fields: [focusSession_id], references: [id])

  @@map("focusTimerSession")
}

// Game State Model
model GameState {
  id Int @id @default(autoincrement())

  // 1 gameState dipunyai 1 user
  user_id Int
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Board state stored as JSON string representing the game board
  boardState String @db.Text

  // Current score
  score Int @default(0)

  // Next blocks stored as JSON string
  nextBlocks String @db.Text

  // Timestamp for when the game state was last updated
  updatedAt DateTime @updatedAt

  // Timestamp for when the game state was created
  createdAt DateTime @default(now())

  @@map("gameStates")
}