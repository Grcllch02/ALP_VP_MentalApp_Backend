// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User{
  // isinya itu mau ada kolom apa saja bisa dibuat disini

  // id itu tipe data int
  id Int @id @default(autoincrement())
  username String @db.VarChar(100)

  // data email unique artinya dia tidak boleh sama dengan yang lain atau yang sudah ada
  email String @db.VarChar(150) @unique 
  password String @db.VarChar(100)

  // untuk kasih nama tabelnya 
  @@map("users")
}

// Fitur Chelseaa
model Music{
  id Int @id @default(autoincrement())
  title String @db.VarChar(100)
  fileUrl String @db.VarChar(100)
  duration Int @db.Integer(100)
  
  @@map("musics")
}

model musicFav{
  id Int @id @default(autoincrement())

  @@map("musicFavorite")
}

model musicCategory{
  id Int @id @default(autoincrement())

  name String @db.VarChar(100)

  @@map("musicCategory")
}

model focusSession{
  id Int @id @default(autoincrement())

  duration Int @db.Integer(100)

  @@map("focusSession")
}

model focusTimerSession{
  id Int @id @default(autoincrement())

  duration Int @db.Integer(100)

  @@map("focusTimerSession")
}